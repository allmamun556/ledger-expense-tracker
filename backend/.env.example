# Copy this file to .env and fill in your own values.

# Used to sign JWT access tokens. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=7a45aecbf1ec628d08ce9fd0f176647842f4f17da0fb11d16c1b42cd15ea48a8

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (only needed if you want "Sign in with Google").
# Create credentials at https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application" and add
# http://localhost:8000 and http://localhost:5500 (or wherever you serve
# the frontend from) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Database connection.
# Local SQLite file (relative to backend/ folder):
DATABASE_URL=sqlite:///./expenses.db
# Or a Postgres database (e.g. Neon — copy the connection string from your
# Neon project dashboard, "Connection Details"):
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
